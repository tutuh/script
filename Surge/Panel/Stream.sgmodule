#!name=网络解锁检测
#!desc=支持：ChatGPT · Gemini · Netflix · Disney+
#!category=Panel
#!arguments=更新频率:-1,请求超时:30,检测超时:3,面板名称:网络解锁检测,Icon:play.tv.fill,Color:E83A5C
#!arguments-desc=[参数说明]\n\n更新频率：面板刷新频率，默认手动刷新\n\n请求超时：面板整体超时时间，单位为秒，默认 30 秒\n\n检测超时：单个网络检测请求超时时间，单位为秒，默认 3 秒\n\n面板名称：自定义面板标题

[Panel]
网络解锁检测 = script-name=解锁检测,update-interval={{{更新频率}}}

[Script]
解锁检测 = type=generic,timeout={{{请求超时}}},script-path=https://raw.githubusercontent.com/tutuh/script/master/Surge/Panel/JS/Stream.js,argument=title={{{面板名称}}}&icon={{{Icon}}}&color=#{{{Color}}}&detection_timeout={{{检测超时}}}
